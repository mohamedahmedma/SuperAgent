# ===== Domain profile =====
# Selects which profile in backend/profiles/definitions/*.yaml drives identity,
# prompts, agent tools, retrieval tuning, and user-facing copy.
# Shipped: supermew (default), base, document_kb, ecommerce.
#
# Precedence for any single value: environment variable > profile YAML > schema default.
# That means a variable set below SILENTLY OVERRIDES the profile — comment it out to
# let the profile decide.
ACTIVE_PROFILE=supermew

# ===== Model provider =====
# Optional. Names which prefixed credential block below is live: groq | together.
# Leave it unset to ignore the blocks and use the generic values in "Model" as written --
# that is the right choice for a single-provider deployment, and for any provider without
# a block (OpenRouter, vLLM, an in-house gateway).
#
# When it IS set, a block value beats the generic name of the same setting, and the
# generic name is the fallback for whatever the live block does not mention. So switching
# provider is one word, every block stays written, and no set can be half-applied.
# Resolution order and the reason for it: backend/llm_provider.py.
# LLM_PROVIDER=together

# --- Together AI ---
# TOGETHER_API_KEY=your_together_api_key
# Defaults to https://api.together.xyz/v1 when unset.
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# TOGETHER_MODEL=your_model_name
# TOGETHER_FAST_MODEL=your_fast_model_name
# TOGETHER_GRADE_MODEL=your_grade_model_name

# --- Groq ---
# GROQ_API_KEY=your_groq_api_key
# Defaults to https://api.groq.com/openai/v1 when unset. Write it out anyway if a generic
# BASE_URL is also set below, since the generic value is consulted before this default.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=your_model_name
# GROQ_FAST_MODEL=your_fast_model_name
# GROQ_GRADE_MODEL=your_grade_model_name

# Each block also accepts the vision trio -- TOGETHER_VISION_MODEL, GROQ_VISION_API_KEY,
# and so on -- for a deployment whose vision model should follow the switch. Leave them
# unset and the generic VISION_* values below stay put across a provider change, which is
# what you want when vision is deliberately pinned to one provider.

# ===== Model =====
# The generic names. Read directly when LLM_PROVIDER is unset; the fallback beneath the
# live block when it is set.
ARK_API_KEY=your_ark_api_key
# Used for complexity planning, and for the Step-back / HyDE single-choice rewrite; a low-latency model.
# A separate, high-capability model dedicated to judging evidence relevance, answerability, ambiguity, and routing.
MODEL=your_model_name

FAST_MODEL=your_fast_model_name

GRADE_MODEL=your_grade_model_name
BASE_URL=https://your-llm-endpoint/v1

# ===== Model sampling, per pipeline node =====
# Six roles, one per node that calls a model:
#   answer   the agent's answering call        (MODEL)
#   fast     rolling persistent-note summary   (FAST_MODEL)
#   planner  question-complexity classifier    (FAST_MODEL)
#   grade    evidence grading                  (GRADE_MODEL)
#   rewrite  Step-back / HyDE query planning   (FAST_MODEL)
#   scope    in-domain / out-of-domain check   (FAST_MODEL)
#
# All values below are commented out: the shipped defaults live in
# backend/profiles/definitions/base.yaml and uncommenting a line overrides the profile.

# --- Reasoning effort (low | medium | high, or none to send no effort parameter) ---
# The largest cost and latency control available on a reasoning model. Output tokens
# bill several times input and are produced one at a time, whereas the entire prompt
# prefills in a single parallel pass — so effort, not prompt size, is what a turn
# mostly costs. Only `answer` does open-ended work; the other five emit a fixed
# structured shape that deliberation does not improve, which is why base.yaml ships
# them at `low`.
#
# Set a role to `none` if your model has no effort parameter — providers reject the
# field rather than ignoring it. `none` is needed because a BLANK value counts as
# unset and falls through to the profile.
# ANSWER_REASONING_EFFORT=medium
# FAST_REASONING_EFFORT=low
# PLANNER_REASONING_EFFORT=low
# GRADE_REASONING_EFFORT=low
# REWRITE_REASONING_EFFORT=low
# SCOPE_REASONING_EFFORT=low
# RESOLVE_REASONING_EFFORT=low
#
# The vision model behind the view_figure tool. Its other settings live in the profile
# under assets.figures, and its effort stays there too — this is the same knob, exposed
# for the same reason. On a small tokens-per-minute quota `none` is the single most
# useful thing to set: the scratchpad is reserved against the allowance before
# generation starts, so turning it off reclaims budget that raising the output ceiling
# cannot.
# VISION_REASONING_EFFORT=none

# --- Output ceiling (0 or unset = no ceiling) ---
# Off by default on purpose: a ceiling that truncates a structured response turns a
# paid call into a parse failure. Set these from an observed p99 output length for your
# corpus, not from a guess. The values below are a starting point to measure against.
# ANSWER_MAX_TOKENS=800
# FAST_MAX_TOKENS=300
# PLANNER_MAX_TOKENS=200
# GRADE_MAX_TOKENS=300
# REWRITE_MAX_TOKENS=500
# SCOPE_MAX_TOKENS=200
# RESOLVE_MAX_TOKENS=200

# --- Temperature ---
# ANSWER_TEMPERATURE=0.3
# FAST_TEMPERATURE=0.2
# PLANNER_TEMPERATURE=0.0
# GRADE_TEMPERATURE=0.0
# REWRITE_TEMPERATURE=0.0
# SCOPE_TEMPERATURE=0.0
# RESOLVE_TEMPERATURE=0.0

# ===== Conversation history sent to the answering model =====
# Counted in MESSAGES, so 14 = 7 user/assistant turns. Halving it drops the assistant
# side of every exchange, and those replies are what later follow-ups point back at
# ("the fees you mentioned earlier") — so lower this by measuring follow-up accuracy,
# not by assuming.
#
# This is the SMALLEST cost lever in the pipeline: the window prefills in parallel and
# only the answering node ever receives it (the planner and grader see the question or
# the documents alone). Reach for the effort settings above first.
# CONTEXT_WINDOW_MESSAGES=14

# Contextual query resolution: one small FAST_MODEL call that rewrites a follow-up into
# a question standing on its own, and names the conditions carried over from earlier
# turns ("grades up to Year 6"). Its output is what scope detection embeds, what
# retrieval searches for, and what a resumed clarification continues from.
#
# ON in the shipped profiles, because with it off "and what about the fees?" is measured
# as the average of itself and the previous turn — and the previous turn wins, so the
# system answers about the wrong subject or asks which subject was meant.
#
# It is gated: a first message, or one longer than agent.query_resolution_max_chars with
# no anaphora and no leading conjunction, never reaches the model. Set this to false only
# to stop paying for it under a quota wall; the system then behaves as it did before.
# QUERY_RESOLUTION_ENABLED=true

# ===== Vision model (images: figure extraction, view_figure, product attributes) =====
# Needed only when a profile sets assets.figures.vision_enabled or
# assets.entities.vision_enabled. Without it the system still works — figures fall
# back to alt-text/caption extraction — but scanned pages stay unreadable and product
# attributes are never populated. Startup logs which state you are in.
#
# Each setting falls back to its text-model equivalent, so if MODEL is already
# vision-capable you need none of these:
#   VISION_MODEL    -> MODEL
#   VISION_API_KEY  -> ARK_API_KEY
#   VISION_BASE_URL -> BASE_URL
# Set them explicitly when the vision model lives on a DIFFERENT provider than the
# text model, which the fallback alone cannot express. Values set here are generic, so
# they hold across an LLM_PROVIDER switch; use a block's <PREFIX>_VISION_* instead when
# vision should move with the provider.
VISION_MODEL=your_vision_model_name
VISION_API_KEY=your_vision_provider_key
VISION_BASE_URL=https://your-vision-endpoint/v1

# ===== Dense embeddings (defaults to BAAI/bge-m3 loaded in this process) =====
# EMBEDDING_BACKEND=local runs the model here. Costs ~2.0 GB resident and ~91 ms per
# query PER PROCESS, so N uvicorn workers cost N copies of identical weights — which is
# the reason the remote option below exists.
#
# EMBEDDING_BACKEND=openai calls any OpenAI-compatible /v1/embeddings endpoint instead,
# dropping this process to a few hundred MB. Two very different deployments use it:
#
#   1. bge-m3 behind HuggingFace text-embeddings-inference or Infinity, in one
#      container that every API worker shares. SAME model, same vectors — no re-index,
#      no retrieval-quality question, no per-token cost. This is the way to add workers
#      without multiplying memory.
#   2. A hosted provider. Cheap per token, but a DIFFERENT model means a different
#      vector space: it requires re-indexing the whole corpus and re-checking retrieval
#      quality in every language served. Measure before switching.
#
# EMBEDDING_MODEL must name the same model the corpus was indexed with, whichever
# backend serves it, and DENSE_EMBEDDING_DIM must match its output width.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
DENSE_EMBEDDING_DIM=1024
# Only read when EMBEDDING_BACKEND is not local. Include the /v1 suffix.
# EMBEDDING_BASE_URL=http://embedder:8080/v1
# EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT_SECONDS=30
# EMBEDDING_BATCH_SIZE=64
# Kept-alive connections to the embedding endpoint. Size to the server's worker
# threads: below that, concurrent callers serialise on one socket.
# EMBEDDING_POOL_SIZE=32

# Concurrently-arriving queries are merged into one embed call. There is no artificial
# delay — a batch is whatever accumulated while the previous one was running — so this
# costs an idle service nothing and pays more the busier it gets. Measured at 64
# concurrent turns: 8.1 -> 13.5 turns/s, p95 9.65s -> 5.46s. Set to 1 to disable.
# EMBEDDING_COALESCE_MAX_BATCH=16

# ===== Database connection pool =====
# Defaults here are 20+20; SQLAlchemy's own defaults are 5+10, which is fewer than the
# server's worker threads and silently caps concurrency — past it, threads block for
# DB_POOL_TIMEOUT_SECONDS and then raise, which reads as "Postgres is slow" rather than
# "the client refused to open a connection".
# Across a fleet: replicas x (POOL_SIZE + MAX_OVERFLOW) must fit Postgres max_connections.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE_SECONDS=1800
# DB_POOL_TIMEOUT_SECONDS=30
# Hugging Face mirror endpoint for faster access in mainland China (fixes hangs when loading local embedding models directly from huggingface.co)
# Set this to https://huggingface.co if the mirror is unreachable from your network.
HF_ENDPOINT=https://hf-mirror.com
# Where the local embedding model is cached. Compose mounts the named volume
# hf_cache here, so EMBEDDING_MODEL downloads once instead of on every recreate.
# Leave unset outside Docker to use the HuggingFace default (~/.cache/huggingface).
# HF_HOME=/app/hf-cache

# ===== Rerank (optional; automatically degrades if not configured) =====
# Any Cohere-compatible /v1/rerank endpoint works unchanged (Cohere, Jina, Voyage,
# self-hosted TEI). For Cohere: RERANK_MODEL=rerank-v3.5, host=https://api.cohere.com
RERANK_MODEL=your_rerank_model
RERANK_BINDING_HOST=https://your-rerank-host
RERANK_API_KEY=your_rerank_api_key
# Maximum wait time for the rerank upstream; placeholder values are automatically detected as disabled.
RERANK_TIMEOUT_SECONDS=3
# Chars of each chunk sent to the reranker; providers bill per ~500-token doc unit.
RERANK_DOC_CHAR_LIMIT=2000

# ===== Retrieval candidate pool & Auto-merging =====
# Number of chunks returned to the Agent after reranking
RETRIEVAL_TOP_K=8
# Number of Milvus leaf-level recall candidates: RETRIEVAL_CANDIDATE_K takes priority when set (and must be >= top_k)
# When K is not set: candidate_k = max(top_k * RETRIEVAL_CANDIDATE_MULTIPLIER, top_k)
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_CANDIDATE_MULTIPLIER=3
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3
# Minimum score for a chunk to reach the Agent after reranking (default 0; calibrate against real data once live)
RERANK_MIN_SCORE=0.0

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=embeddings_collection
# Per-RPC timeout (seconds); connections are created per request and don't hold a long-lived gRPC channel
MILVUS_TIMEOUT=30
# Host port for the optional Attu Milvus dashboard. Attu still listens on port
# 3000 inside its container; 8081 avoids common local services that use 8080.
ATTU_HOST_PORT=8081

# ===== Asset (image) blob storage =====
# The backend is chosen by the profile (assets.blob_backend: local | s3). Only
# CREDENTIALS live here — profiles are committed to the repository.
# Needed solely when a profile selects blob_backend: s3. Point this at its OWN
# bucket; never reuse the bucket Milvus stores its segments in.
# ASSET_S3_ENDPOINT=http://127.0.0.1:9000
# ASSET_S3_ACCESS_KEY=minioadmin
# ASSET_S3_SECRET_KEY=minioadmin
# ASSET_S3_REGION=us-east-1

# ===== Database / Cache =====
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/langchain_app
REDIS_URL=redis://127.0.0.1:6379/0

# ===== HTTP surface =====
# Origins allowed to call the API, comma-separated. Read by BOTH backend/ and
# identity/ -- the UI talks to both, and two variables would let them disagree about
# which origin it is. Unset means any origin, which
# is safe here only because authentication is a bearer token in the Authorization
# header — a hostile page can send a cross-origin request but has no token to put
# in it, and no cookie is ever attached automatically. Pin it once the UI's origin
# is fixed. Include the scheme and port, and no trailing path.
CORS_ALLOW_ORIGINS=https://superagent.aurexis.cc

# --- SIS's cross-origin access, which is deliberately NOT the list above ----------
# `sis/` reads its own SIS_CORS_ORIGINS and does NOT read CORS_ALLOW_ORIGINS. That is a
# decision, not an oversight, and it is written down here because the naming looks like an
# oversight and the "fix" is a security regression.
#
# CORS_ALLOW_ORIGINS names the origin of the PARENT-facing Vue app, which calls the chat
# backend and identity. It never calls sis. Sis is reached by the registrar console it
# serves itself at /ui, from its own origin, which needs no CORS at all.
#
# So folding the two together would not tidy anything — it would tell a service that
# answers with named children's marks to start accepting requests from the parents' app.
# Worse, sis authenticates nobody at present (see the SIS access keys section at the end of
# this file), so an allowed origin is genuinely all that stands between a page and a term's
# marks.
#
# UNSET means no CORS middleware is installed at all: closed, which is the right default
# for this service. Set it only for a separately hosted registrar console, and name that
# console's origin — never the parents' app.
# SIS_CORS_ORIGINS=https://registrar.example.com
# SIS_CORS_ALLOW_CREDENTIALS=false

# ===== The Vue app (frontend/) =====
# The Vue app reads THIS file: `frontend/vite.config.ts` sets `envDir` to the repo root.
# There is deliberately no `frontend/.env` — two files holding the same addresses is a
# disagreement waiting to happen, and it is a silent one, because nothing reads both.
#
# Vite inlines ONLY names beginning with `VITE_` into the browser bundle, so every secret
# above and below stays out of it. That makes one rule absolute: NEVER give a secret a
# name starting with VITE_. `frontend/src/config.spec.ts` fails the suite if you do,
# including the case where a secret's VALUE is copied onto a new VITE_ name.
#
# Both are read at BUILD time and baked into the bundle: changing one means running
# `npm run build` again. Restarting a server does nothing.

# Which identity service the browser talks to. EMPTY means "my own origin", which in
# development lets vite proxy /v1 to the same identity process the other services use —
# and the WhatsApp flow REQUIRES that, because the browser's challenge and Meta's webhook
# must reach one database. Set it only when the frontend is deployed and identity is
# genuinely remote, and add this frontend's origin to CORS_ALLOW_ORIGINS at the same time.
# Which chat backend the browser talks to. EMPTY means "my own origin", which the vite dev
# proxy and any co-hosting reverse proxy both handle. Set it when the UI and the API are on
# different hosts (VITE_API_BASE_URL=https://api.example.com), and add the UI's origin to
# CORS_ALLOW_ORIGINS at the same time — setting only one turns a 404 into a CORS error.
VITE_API_BASE_URL=

VITE_IDENTITY_BASE_URL=

# Which school the login page belongs to. Empty for a single-school deployment; setting it
# against a server that has no IDENTITY_SCHOOLS makes /v1/auth/whatsapp/start refuse.
VITE_SCHOOL_CODE=

# --- the vite dev server's proxy (development only) -------------------------------
# `npm run dev` forwards /chat, /sessions, /documents and /media to the backend, and /v1
# to identity, so a local browser reaches four services through one origin. `vite build`
# emits none of it — which is the trap worth naming: with the proxy running, the app needs
# no VITE_*_BASE_URL at all, so it looks configured while being configured for nothing, and
# the first deploy to a separate domain 404s on every call.
#
# Unset means the ports each service documents for itself: backend 8000, identity 8200.
# Set them only to run against something else — a container, a colleague's machine.
# DEV_PROXY_BACKEND=http://localhost:8000
# DEV_PROXY_IDENTITY=http://localhost:8200

# Whether to serve the bundled Vue UI from frontend/dist at "/". Set false for a
# backend-only deployment, so that a stale bundle finding its way into the image
# cannot turn the API into a web server — and so a health check on "/" gets a 404
# rather than a 200 served off disk regardless of backend health.
# SERVE_FRONTEND=false

# Compiled into the Vite browser bundle at image build time. Production uses the
# public Identity origin; local development leaves it empty and uses Vite's /v1 proxy.
VITE_IDENTITY_BASE_URL=https://auth.aurexis.cc

# ===== Auth =====
JWT_SECRET_KEY=replace-with-strong-random-secret
ADMIN_INVITE_CODE=superagent-admin-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PASSWORD_PBKDF2_ROUNDS=310000

# Internal verification endpoint used by backend and records on the Compose network.
IDENTITY_JWKS_URL=http://identity:8200/.well-known/jwks.json

# ===== The administrator this service guarantees exists =====
# Seeded on EVERY startup, not by a migration. A migration runs once per version; the
# requirement is stronger than that — the account must be there however the database
# arrived: brand new, upgraded, restored from last night's backup, or with the row deleted
# by somebody clearing out test data. `init_db()` already runs on every boot and says it is
# safe to, so the seed rides along with it. Delete the row and the next restart puts it back.
#
# IT NEVER OVERWRITES AN EXISTING USERNAME. Change this account's password through the API
# and the next deploy leaves it alone. Without that rule this would be a scheduled
# credential reset that hands the account back to anyone who ever read this file.
#
# Set BOTH or NEITHER. Half-configured is refused and logged, because an account with an
# empty password is not a degraded state, it is an open door.
#
# --- the honest caveat ---------------------------------------------------------------
# Anyone who can read this file can sign in as this administrator. That is a smaller surface
# than the shared X-Admin-Key it replaces — the credential belongs to a NAMED account, so
# every action it takes is attributable; it can be changed through the API without a
# redeploy; and it is subject to the same lockout policy as any other login — but it is not
# zero. Change the password through the admin routes once the estate is running: seeding
# skips the account from then on, so the value below stops being the live credential.
#
# LEFT EMPTY DELIBERATELY. Nothing is seeded until you fill both in, and identity logs
# "No active administrator account exists" on every boot until you do. There is no default
# username and no default password anywhere in the code — a default IS a known credential,
# which is the whole objection to the shared key this replaces.
#
# Pick a password nobody has seen. For example:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
IDENTITY_BOOTSTRAP_ADMIN_USER=
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=

# ===== Wiring the four services together =====
# Nothing below has a sensible default, because a default would be a guess about
# somebody else's deployment. Each line names what breaks when it is missing, since
# every one of these failures is silent: the service starts, the endpoint answers, and
# a parent is told something untrue.
#
# Ports match each service's own docs: SIS 8300, records 8100, identity 8200.

# Which deployment this backend is. `school` is the only profile that binds
# get_student_records; without it a parent's question about their child has no tool to
# answer it and gets answered from the knowledge base instead.
ACTIVE_PROFILE=school

# --- backend -> records ---------------------------------------------------------
# Where the chat backend reads a child's marks and attendance. Missing: every records
# question answers "records are temporarily unavailable".
RECORDS_BASE_URL=http://records:8100
# The one credential `records/` has, and it is invented here — a long random string.
# Both sides read this same variable: the chat backend sends it, `records/` compares
# against it. There is no admin API to mint it through any more, because there is no key
# table to mint into: the service holds no database at all.
#
# It FAILS CLOSED. Left blank, `records/` refuses every request with a 503 rather than
# admitting everyone, so a half-configured deployment is a support call and not an open
# door onto the school's records.
RECORDS_API_KEY=

# --- records -> SIS -------------------------------------------------------------
# Which system of record answers. `sis` is the school's own; `fake` is fixtures.
# Missing: records serves fixture data and looks healthy.
RECORDS_LMS=sis
# Where that SIS is. Missing: every parent is told they have no children on file —
# records leaves its guardian directory as an empty in-memory fake and says so in a
# startup warning that is easy to miss.
#
# The service's OWN ORIGIN, with NO path. The clients join their paths relative to this,
# so a value like `https://sis.example/ui/` — the registrar console rather than the API —
# sends every lookup to `/ui/v1/students/...` and gets a redirect or a 404 back. Both
# adapters detect exactly that and say so; see `records/adapters/sis/grades.py`.
SIS_BASE_URL=http://sis:8300
SIS_REGISTRAR_API_KEY=

# --- identity -> SIS ------------------------------------------------------------
# How identity answers "is this WhatsApp number a parent's, and whose". This is the
# one that breaks the sign-in AFTER the link works: with it unset, the parent sends
# the message, the webhook arrives, and identity looks them up in an empty directory
# and replies that their number is not registered.
#
# OPTIONAL. Identity falls back to SIS_BASE_URL above, so an estate with one SIS sets one
# variable instead of two that have to agree — and filling in only the `records/` spelling
# no longer leaves sign-in broken while marks work perfectly. Set this only to point
# identity at a DIFFERENT SIS. IDENTITY_SIS_API_KEY falls back to SIS_API_KEY the same way.
IDENTITY_SIS_BASE_URL=http://sis:8300

# --- databases ------------------------------------------------------------------
# Two services own one each. Defaults drop a SQLite file in the working directory,
# which is fine for development and is why they are commented rather than blank —
# setting them to an empty string would be read as "" and not as "use the default".
#
# `records/` is absent from this list on purpose: it holds no database. Every fact it
# serves is asked for at request time, so there is nothing to back up or migrate.
# SIS_DATABASE_URL=sqlite:///./sis.db
# IDENTITY_DATABASE_URL=sqlite:///./identity.db

# ===== Several schools: one database each =====================================
# Schools are separated PHYSICALLY. Each has its own database, holding the same
# tables and the same schema, and no query in the service spans two of them. What
# isolates a school is therefore the connection, not a `WHERE` clause somebody has
# to remember: a read that reaches the wrong school finds nothing, because the rows
# are not in the file it is connected to.
#
# Leave SIS_SCHOOLS unset to run exactly as before — one database, no header, no
# registry. Everything below only takes effect once it names something, so an estate
# is split by editing this file rather than by rolling out new code.
#
# SIS_SCHOOLS=MAIN,NCS
#
# One database URL per school. The variable's suffix is the school code with `.` and
# `-` folded to `_`, because those are legal in a school code and illegal in an
# environment variable name. There is deliberately NO shared default: falling back to
# one would put two schools' rows in a single file, which is the whole thing this
# design exists to prevent, so a school named here with no URL stops the service at
# startup instead of at eight in the morning.
#
# SIS_DATABASE_URL_MAIN=sqlite:///./schools/MAIN.db
# SIS_DATABASE_URL_NCS=sqlite:///./schools/NCS.db
#
# --- Creating a school without editing this file by hand ---------------------
#
# The two variables above used to be written by a person BEFORE `provision` would
# run, so creating a school was an edit and a command, and getting them out of step
# produced a service that would not start. `python -m sis.schools provision NCS`
# now renders the connection itself and appends both lines here.
#
# What it renders them from. One template for the whole estate, because every school
# is the same provider on the same server and only the connection differs. `{slug}`
# is the school code lowercased with `.` and `-` folded to `_` — the same folding the
# variable name above uses, so the database and the variable pointing at it cannot
# disagree about which school they mean. `{code}` is the code verbatim.
#
# SIS_DATABASE_URL_TEMPLATE=postgresql+psycopg2://sis:pw@db:5432/sis_{slug}
#
# Creating a PostgreSQL database needs a role that can CREATE DATABASE — and a role
# that can create one can drop one, which the process answering parent requests has
# no business holding. So it is a SEPARATE credential, pointed at the server's
# maintenance database, and provisioning is the only thing that uses it.
#
# SIS_ADMIN_DATABASE_URL=postgresql+psycopg2://sis_admin:pw@db:5432/postgres
#
# Leaving SIS_ADMIN_DATABASE_URL unset is a supported choice, not an oversight: it
# disarms `POST /v1/admin/schools`, which then answers 503 and says so. Schools are
# then created from a terminal on the server, which is where a deployment that does
# not want its web process holding CREATE DATABASE should keep them.
#
# On SQLite neither variable is needed for the database itself — alembic creates the
# file — but the template is still what names it:
#
# SIS_DATABASE_URL_TEMPLATE=sqlite:///./schools/{code}.db
#
# One caveat worth knowing before wiring the console button. SIS_SCHOOLS is read once
# per process, so a school created through the API is live in the worker that served
# the request and not in the others until they restart and re-read this file.
#
# Requests then name a school with the `X-School-Code` header, and SIS answers from
# that school's database and no other. Where several schools are configured the header
# is REQUIRED: an absent one is refused rather than defaulted, because "the first
# school" and "the only school" both become the wrong school the day another is added.
#
# Two things follow from splitting that are worth knowing before you do:
#   * Academic year codes stop being globally unique in any useful sense — every school
#     will have its own `2025-2026`, which is fine, and simpler than the prefixes a
#     single database forced.
#   * `students.student_number` is unique per FILE, so the same number at two branches
#     is two children. A child moving between branches is a transfer to be carried
#     across by hand; there is no query that can see both.
#
# Run migrations for every school with `python scripts/schools.py migrate`, and split an
# existing single-database estate with `python scripts/schools.py split` — see that
# script for what it does and what it refuses to guess.

# ===== WhatsApp: how a parent signs in =====
#
# The flow, so each setting below has a job you can point at:
#   1. the browser asks identity to start a verification
#   2. identity hands the parent a wa.me link with a one-time phrase in it
#   3. the parent taps send; WhatsApp delivers it to the school's number
#   4. Meta POSTs that message to our webhook          <- needs CLOUD API
#   5. identity looks the sender up in sis, and replies with a 6-digit code
#   6. the parent types the code; identity mints a token naming their children
#
# Steps 1-3 work with any WhatsApp number, which is why the link can look perfect while
# nothing happens: step 4 is the half Meta owns, and without a Cloud API registration
# the message reaches a phone and no software ever hears about it.

# --- the school's number --------------------------------------------------------
# MUST be E.164 with a leading `+`. `01027106957` is a fine way to dial the number and
# a broken way to link to it — it produces wa.me/01027106957, a different number, so
# every parent's link opens a chat with nobody. Identity refuses to start rather than
# serve that.
IDENTITY_WHATSAPP_NUMBER=

# --- sending the code back (Cloud API) -------------------------------------------
# The ID BESIDE the number in the console, not the number itself. Mixing them up gives
# Meta error 100 on every send.
IDENTITY_WHATSAPP_PHONE_NUMBER_ID=

# ⚠ TEMPORARY TOKEN — expires under 24 hours from when it was issued.
#
# This is the one shown on the App Dashboard's API Setup page. It is fine for today and
# it will stop working overnight, and the only symptom is `code=190` in identity's log
# while parents see "the code never arrived".
#
# Before this is used by anyone but you:
#   Business Settings -> Users -> System Users -> add one
#   -> Assign assets: the app AND the WhatsApp Business Account
#   -> Generate token: permission `whatsapp_business_messaging`, expiry Never
IDENTITY_WHATSAPP_TOKEN=

# Pinned deliberately. Meta ships breaking changes between versions, so "latest" means
# breaking on a date nobody chose. Match whatever the console generated its examples
# against; bump it on purpose after reading the changelog.
IDENTITY_WHATSAPP_GRAPH_VERSION=v22.0

# --- receiving the parent's message (the webhook) --------------------------------
# Any string you invent; type the SAME one into the console's webhook form. Meta echoes
# a challenge on subscription and identity answers only if these match.
IDENTITY_WHATSAPP_VERIFY_TOKEN=

# App settings -> Basic -> App Secret -> Show. This is what proves an inbound webhook
# really came from Meta rather than from anyone who found the URL. Unset means every
# message is rejected, which is the safe direction but looks like nothing happening.
IDENTITY_WHATSAPP_APP_SECRET=

# --- development only ------------------------------------------------------------
# Writes the six-digit code into identity's log so the flow can be completed without a
# phone. The body IS the credential: anywhere a real parent can sign in, this puts their
# code in a file that is backed up and shipped to a log aggregator. Turn it off before
# anyone else uses this.
IDENTITY_WHATSAPP_LOG_CODES=false

# ===== LangSmith tracing (optional; leave LANGSMITH_TRACING unset/false to disable) =====
# When enabled, every LangChain/LangGraph run (RAG graph nodes, all LLM calls, the Milvus
# retrieval call, and the rerank HTTP call) is logged to your LangSmith project as a trace.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=superagent-rag
# Only needed for self-hosted/EU LangSmith; omit to use the default https://api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# ===== Docker Compose local runtime =====
# Secrets are generated into the ignored .runtime.env by SUPERAGENT.bat.
# Leave these blank in the committed template; use GitHub Secrets in deployment.
POSTGRES_DB=langchain_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
LOCAL_SERVICE_KEY=
IMAGE_TAG=local

# Every public host port is configurable. Internal container ports stay fixed.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
RECORDS_HOST_PORT=8100
IDENTITY_HOST_PORT=8200
SIS_HOST_PORT=8300
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MILVUS_HOST_PORT=19530
MILVUS_HEALTH_HOST_PORT=9091
