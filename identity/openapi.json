      "WhatsAppStartOut": {
        "properties": {
          "poll_secret": {
            "type": "string",
            "title": "Poll Secret",
            "description": "Hold this in the page and send it back with the code. Never shown again, never sent over WhatsApp, and never put in a URL."
          },
          "link": {
            "type": "string",
            "title": "Link",
            "description": "Opens WhatsApp with the message already typed. The parent must still tap send — WhatsApp never sends it for them.",
            "examples": [
              "https://wa.me/201288339613?text=SCHOOL%20VERIFY%3A%20K7QP4M2X"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "The exact text the link pre-fills. Show it beside the button so a parent whose in-app browser swallowed the link can send it by hand.",
            "examples": [
              "SCHOOL VERIFY: K7QP4M2X"
            ]
          },
          "business_number": {
            "type": "string",
            "title": "Business Number",
            "description": "The school's WhatsApp number, for the same manual fallback.",
            "examples": [
              "+201288339613"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "poll_secret",
          "link",
          "message",
          "business_number",
          "expires_at"
        ],
        "title": "WhatsAppStartOut",
        "description": "What a browser gets when it begins a WhatsApp verification.\n\n`poll_secret` is shown exactly once and is never recoverable — it is this browser's\nhalf of the proof, and the reason somebody who forwards the link cannot finish the\nlogin in your place."
      },
