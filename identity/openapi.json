      "WhatsAppStartOut": {
        "properties": {
          "poll_secret": {
            "type": "string",
            "title": "Poll Secret",
            "description": "Hold this in the page and send it back with the code. Never shown again, never sent over WhatsApp, and never put in a URL."
          },
          "link": {
            "type": "string",
            "title": "Link",
            "description": "Opens WhatsApp with the message already typed. The parent must still tap send — WhatsApp never sends it for them.",
            "examples": [
