        "title": "WhatsAppStartOut",
        "description": "What a browser gets when it begins a WhatsApp verification.\n\n`poll_secret` is shown exactly once and is never recoverable — it is this browser's\nhalf of the proof, and the reason somebody who forwards the link cannot finish the\nlogin in your place."
      },
      "WhatsAppStatusIn": {
        "properties": {
