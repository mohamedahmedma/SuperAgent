{
  "openapi": "3.1.0",
  "info": {
    "title": "School Identity Service",
    "description": "Authentication for the school assistant. The only service that decides who someone is, and the only one that can mint a token.\n\n**Tokens are RS256.** Other services verify against `/.well-known/jwks.json` with a public key and hold nothing that could forge one. That is what keeps identity resolution out of the chat backend and the records facade.\n\n**The `guardian_id` claim is the whole integration.** It is set only by an administrator through `PUT /v1/admin/accounts/{username}/guardian-binding`, never at self-registration and never from a request body on a public route. A token without the claim can read no student records at all.\n\n**Parents sign in through WhatsApp, not with a password.** They ask for a challenge, send a pre-filled message from their own WhatsApp, and type back a code. WhatsApp proves they control the number; the school's own records decide whether that number belongs to a parent. Neither the browser nor the parent ever states which guardian they are.",
    "version": "0.1.0"
  },
  "paths": {
    "/.well-known/jwks.json": {
      "get": {
        "tags": [
          "keys"
        ],
        "summary": "Jwks",
        "description": "The public signing key.\n\nEvery other service verifies tokens against this and holds nothing that could mint\none. Public by design — a public key is not a secret.\n\nVerification elsewhere is **offline**: no service calls this one per request, so\nidentity being down does not take records down, and this service is not in the latency\npath of a parent's question.",
        "operationId": "jwks__well_known_jwks_json_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Jwks  Well Known Jwks Json Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Exchange credentials for tokens.\n\nAn unknown username and a wrong password produce the same 401 with the same message,\nin the same time. Distinguishing them turns this endpoint into an account enumerator,\nand for a school that means confirming which parents are registered.",
        "operationId": "login_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "423": {
            "description": "Account temporarily locked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh",
        "description": "Exchange a refresh token for a fresh access token — and a fresh refresh token.\n\nThe guardian binding is re-read from the account, not carried over from the old token.\nThat is what makes a revoked or corrected binding take effect within one access-token\nlifetime instead of persisting until the parent happens to log out — the case that\nmatters is a custody change, and it must not wait a month.\n\nThe token presented is spent. Keep the one returned: it carries the session forward\nfor another full inactivity window, so a parent who keeps using the app is never asked\nto sign in again. Presenting a spent token outside its grace window ends the session.",
        "operationId": "refresh_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenOut"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "423": {
            "description": "Account temporarily locked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "Sign out: revoke the session the refresh token belongs to.\n\nThe whole session, not the one token — every refresh token rotated from the same\nsign-in dies with it. The access token already issued stays valid until it expires:\noffline verification is the trade made for not calling this service on every request,\nand keeping access tokens short is what bounds that window.",
        "operationId": "logout_v1_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Logout V1 Auth Logout Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "description": "Decode the caller's own token. Useful to a front end; used by nothing critical.",
        "operationId": "me_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "423": {
            "description": "Account temporarily locked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/auth/whatsapp/start": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Start Whatsapp Verification",
        "description": "Begin a verification. Takes no phone number, and that is the point.\n\nBecause the caller states nothing about a *parent*, there is nothing here to probe:\nthis endpoint cannot be used to ask whether a given number belongs to a parent. That\nquestion is answered only to somebody who can actually send a WhatsApp message from\nthe number, and it is answered over WhatsApp rather than in this response.\n\nThe school is not a secret and does not weaken that: it names the login page the parent\nis standing on, which is public. What it buys is the pairing — the school recorded here\nmust match the school that owns the number the parent's message arrives on, so a nonce\nsteered to the wrong school's number is refused rather than resolved against a database\nthe parent's children are not in.\n\nA missing number is a 503 and an unknown school a 404, both decided in\n`api/errors.py`: the first is the operator's to fix, the second the caller's.",
        "operationId": "start_whatsapp_verification_v1_auth_whatsapp_start_post",
        "parameters": [
          {
            "name": "school",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Which school the parent is signing in to. Required where this server holds several; omitted where it holds one. It selects the WhatsApp number the link points at, and is checked again when the parent's message arrives.",
              "title": "School"
            },
            "description": "Which school the parent is signing in to. Required where this server holds several; omitted where it holds one. It selects the WhatsApp number the link points at, and is checked again when the parent's message arrives."
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhatsAppStartOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/whatsapp/status": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Whatsapp Verification Status",
        "description": "Where has this verification got to? Polled while the parent goes to tap send.",
        "operationId": "whatsapp_verification_status_v1_auth_whatsapp_status_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatsAppStatusIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhatsAppStatusOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/whatsapp/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Complete Whatsapp Verification",
        "description": "The code, and the tokens if it is right.\n\nThe account is created here on first use rather than by an administrator, and the\nbinding written onto it does not come from this request: it came from the school's own\nrecords, keyed on a number WhatsApp proved. That is the invariant\n`domain/accounts.py` states — an account never names its own guardian — held through a\nsecond authority rather than broken by one.",
        "operationId": "complete_whatsapp_verification_v1_auth_whatsapp_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatsAppVerifyIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "423": {
            "description": "Account temporarily locked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/accounts": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Create Account",
        "description": "Create a login. Note what this route cannot do: bind a guardian.\n\nCreation and binding are deliberately two calls. A bulk parent import that runs only\nthis one produces accounts that can log in and read nothing, which is the safe\nhalf-finished state.",
        "operationId": "create_account_v1_admin_accounts_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List Accounts",
        "description": "Every account, a page at a time.\n\nPaged rather than returned whole because a school is thousands of parents, and a\nmanagement screen that fetches all of them works perfectly on the developer's fixture\ndata and times out on the first real deployment.",
        "operationId": "list_accounts_v1_admin_accounts_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountListOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/accounts/{username}/guardian-binding": {
      "put": {
        "tags": [
          "admin"
        ],
        "summary": "Bind Guardian",
        "description": "Bind a login to a guardian. The single most sensitive write in the system.\n\nAudited as its own event type, because \"who decided this parent is that guardian\" is\nthe first question anyone asks after a records leak.",
        "operationId": "bind_guardian_v1_admin_accounts__username__guardian_binding_put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Username"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuardianBindingIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "admin"
        ],
        "summary": "Unbind Guardian",
        "description": "Remove a binding — the custody-change path.\n\nTakes effect for new access tokens immediately, for existing ones within their\nremaining lifetime, and for the session itself now: the refresh tokens are revoked\nhere, so the parent cannot mint a fresh access token to carry on with.",
        "operationId": "unbind_guardian_v1_admin_accounts__username__guardian_binding_delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Username"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/accounts/{username}": {
      "patch": {
        "tags": [
          "admin"
        ],
        "summary": "Update Account",
        "description": "Change an account. PATCH, not PUT: absent means unchanged, never \"clear it\".\n\nWith PUT, a management form that forgot to send `display_name` would erase it, and a\nform that forgot `is_active` would silently reactivate somebody who was suspended.\n\nThis route cannot bind a guardian — `AccountUpdateIn` has no such field and forbids\nextras, so an attempt is refused rather than ignored.",
        "operationId": "update_account_v1_admin_accounts__username__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Username"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountUpdateIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "admin"
        ],
        "summary": "Delete Account",
        "description": "Delete an account and revoke its sessions.\n\nRefused for the last active administrator: losing every admin means nobody can bind a\nparent to their children until the seeded account is restored by a restart.\n\n204 with no body, because there is no longer anything to describe.",
        "operationId": "delete_account_v1_admin_accounts__username__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Username"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health",
        "description": "Deliberately shallow.\n\nIt answers \"is this process serving\" and nothing else — it opens no database\nconnection and calls no dependency. A health check that reached SIS would take this\nservice out of a load balancer because a *different* service was slow, and a health\ncheck that touched the database would be one more connection per poll, forever.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessTokenOut": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "Bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "refresh_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Refresh Expires At"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_at",
          "refresh_token",
          "refresh_expires_at"
        ],
        "title": "AccessTokenOut",
        "description": "What a refresh returns.\n\nThe refresh token presented is spent by the exchange; `refresh_token` is the one to\nkeep. A client that ignores it keeps working for as long as the grace window allows\nand no longer — see `SessionService.refresh`."
      },
      "AccountIn": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "user | admin | parent | staff",
            "default": "parent"
          },
          "phone": {
            "type": "string",
            "title": "Phone",
            "default": ""
          },
          "display_name": {
            "type": "string",
            "title": "Display Name",
            "default": ""
          },
          "preferred_language": {
            "type": "string",
            "title": "Preferred Language",
            "default": "ar"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "AccountIn"
      },
      "AccountListOut": {
        "properties": {
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/AccountOut"
            },
            "type": "array",
            "title": "Accounts"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "accounts",
          "total",
          "limit",
          "offset"
        ],
        "title": "AccountListOut",
        "description": "One page, and the total so a management screen can render a pager."
      },
      "AccountOut": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "default": ""
          },
          "guardian_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guardian Id"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active",
            "default": true
          },
          "display_name": {
            "type": "string",
            "title": "Display Name",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "username"
        ],
        "title": "AccountOut",
        "description": "What the admin routes echo back. Never a password hash, never a token."
      },
      "AccountUpdateIn": {
        "properties": {
