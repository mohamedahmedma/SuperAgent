            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "The exact text the link pre-fills. Show it beside the button so a parent whose in-app browser swallowed the link can send it by hand.",
            "examples": [
              "SCHOOL VERIFY: K7QP4M2X"
            ]
          },
          "business_number": {
            "type": "string",
            "title": "Business Number",
