            "type": "string",
            "title": "Teacher Name",
            "default": ""
          },
          "computed_percentage": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Computed Percentage",
            "description": "The school's OFFICIAL course total, exactly as the gradebook has it — including attendance and any other graded activity. Null when nothing is gradeable yet, which is not the same as zero."
          },
          "letter_grade": {
            "type": "string",
            "title": "Letter Grade",
            "default": ""
          },
          "passed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passed"
          },
          "academic": {
            "$ref": "#/components/schemas/AcademicGrade",
            "description": "The same subject counting assessments only."
          },
          "categories": {
            "items": {
              "$ref": "#/components/schemas/GradeCategory"
            },
            "type": "array",
            "title": "Categories",
            "description": "The system of record's own category subtotals."
          },
          "graded_count": {
            "type": "integer",
            "title": "Graded Count",
            "default": 0
          },
          "excused_count": {
            "type": "integer",
            "title": "Excused Count",
            "default": 0
          },
          "missing_count": {
            "type": "integer",
            "title": "Missing Count",
            "default": 0
          },
          "pending_count": {
            "type": "integer",
            "title": "Pending Count",
            "default": 0
          },
          "is_complete": {
            "type": "boolean",
            "title": "Is Complete",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "course_id"
        ],
        "title": "CourseGrade",
        "description": "One subject for one term — the answer to \"how is my child doing in maths\".\n\nEvery figure here was computed by the system of record. This service classifies\n(letter, pass/fail) but does not calculate, because a second implementation of the\ngradebook's arithmetic is a second answer waiting to contradict the first.\n\n`excused_count` is surfaced rather than hidden so a figure can be explained: a\nparent comparing two children deserves to know one had three assessments excused."
      },
      "CourseGradeDetailOut": {
        "properties": {
          "student": {
            "$ref": "#/components/schemas/StudentRef"
