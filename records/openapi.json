            "type": "string",
            "title": "Message",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "ErrorOut",
        "description": "Machine-readable failure.\n\n`code` exists so the agent branches on a value rather than on prose. The one that\nmatters most is `lms_unavailable`: it must produce \"I cannot reach the school\nrecords right now\", never an answer the model invented to be helpful."
      },
      "GradeCategory": {
        "properties": {
          "name": {
            "type": "string",
