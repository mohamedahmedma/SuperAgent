            "$ref": "#/components/schemas/TermOut"
          },
          "present_count": {
            "type": "integer",
            "title": "Present Count",
            "default": 0
          },
          "absent_count": {
            "type": "integer",
            "title": "Absent Count",
            "default": 0
          },
          "late_count": {
            "type": "integer",
            "title": "Late Count",
            "default": 0
          },
          "excused_count": {
            "type": "integer",
            "title": "Excused Count",
            "default": 0
          },
          "total_sessions": {
            "type": "integer",
            "title": "Total Sessions",
            "default": 0
          },
          "attendance_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attendance Rate"
