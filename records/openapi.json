            "items": {
              "$ref": "#/components/schemas/AttendanceDay"
            },
            "type": "array",
            "title": "Recent Days",
            "default": []
          },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          }
        },
        "type": "object",
        "required": [
          "student",
          "term",
          "as_of"
        ],
        "title": "AttendanceSummaryOut",
        "description": "Attendance for one student over a window.\n\nCounts first, days second. The agent answers \"how many days has she missed\" far\nmore often than \"list them\", and a summary that forces it to count a list is a\nsummary that will eventually be counted wrong."
      },
      "CourseGrade": {
        "properties": {
          "course_id": {
            "type": "string",
