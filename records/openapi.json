          }
        },
        "type": "object",
        "required": [
          "guardian_id"
        ],
        "title": "StudentListOut",
        "description": "The students one guardian is permitted to ask about.\n\nAn empty list is a legitimate, non-error answer — it is what a guardian with no\nvisible children gets, and it is deliberately indistinguishable from a guardian\nwhose children are all restricted. Distinguishing them would let a caller probe\nfor the existence of a restriction."
      },
      "StudentRef": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id",
            "description": "The school's student number."
          },
          "full_name_ar": {
            "type": "string",
            "title": "Full Name Ar",
            "default": ""
          },
          "full_name_en": {
            "type": "string",
            "title": "Full Name En",
            "default": ""
          },
          "grade_level": {
            "type": "string",
            "title": "Grade Level",
            "default": ""
          },
          "section": {
            "type": "string",
            "title": "Section",
            "default": ""
          },
          "gender": {
            "type": "string",
