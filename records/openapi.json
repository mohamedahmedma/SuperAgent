  "components": {
    "schemas": {
      "AcademicGrade": {
        "properties": {
          "percentage": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Percentage"
          },
          "letter_grade": {
            "type": "string",
            "title": "Letter Grade",
            "default": ""
          },
          "passed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passed"
          },
          "unavailable": {
            "type": "string",
            "title": "Unavailable",
            "description": "Empty when `percentage` is present. Otherwise why not: 'aggregation_not_summable' (the course uses a weighted or drop-lowest scheme that cannot be re-derived — read `categories` instead), 'no_assessment_items', 'nothing_gradeable'.",
            "default": ""
          }
        },
        "type": "object",
        "title": "AcademicGrade",
        "description": "The subject with non-assessment activities removed.\n\nSeparate from the headline figure rather than replacing it, because a school that\ngrades attendance produces two true answers to \"how is she doing in maths\" and they\nare not interchangeable. Measured on a real instance: 65% official, 80% academic,\nsame child, same subject.\n\n`percentage` is None whenever it could not be derived EXACTLY — never an estimate.\nA consumer that ignores a caveat flag puts the estimate in front of a parent, so\nthere is no estimate to ignore."
      },
      "AssignmentGrade": {
        "properties": {
          "assignment_id": {
            "type": "string",
            "title": "Assignment Id"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": ""
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due Date"
          },
          "status": {
            "$ref": "#/components/schemas/SubmissionStatus"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "max_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Score"
          },
          "percentage": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Percentage"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "default": ""
          },
          "graded_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Graded At"
          }
        },
        "type": "object",
        "required": [
          "assignment_id",
          "status"
        ],
        "title": "AssignmentGrade",
        "description": "One assignment, as the parent sees it."
      },
      "AttendanceDay": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time",
            "title": "Date"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "present | absent | late | excused"
          },
          "course_id": {
            "type": "string",
            "title": "Course Id",
            "default": ""
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": ""
          }
        },
