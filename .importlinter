# The dependency rule, enforced instead of documented.
#
#   PYTHONPATH=src lint-imports
#
# The backend's layers are the ones `sis`, `identity` and `records` already use:
#
#   api/           HTTP in and out. Parses a request, calls a service, maps the result.
#   application/   the use cases (services/) and the ports they reach the world through.
#   domain/        pure rules and the errors they raise.
#
# with `infra/` holding the adapters that implement the ports, and `composition.py` the one
# module that wires everything to everything. There is no command bus and no handler layer:
# a route calls a service method, as in the sibling services.
#
# What sits outside these contracts - agent/, assets/, db/, indexing/, jobs/, profiles/,
# prompts/ and the loose top-level modules - is deliberately unpoliced. They are the turn
# pipeline and the ingestion machinery, kept as plain composed code on purpose, and a rule that
# has to be suppressed for two hundred existing edges teaches nobody anything.
#
# Mechanics worth knowing before editing this file, each established by experiment rather than
# from the documentation:
#   - `layers` and `forbidden` both follow INDIRECT chains: application -> x -> fastapi breaks
#     the contract just as a direct import does, and the report prints the whole chain.
#   - `layers` ERRORS on a module that does not exist, but `forbidden` PASSES VACUOUSLY on one,
#     internal or external, installed or not. A misspelled name in a forbidden list therefore
#     guards nothing and says nothing. Check each new entry by planting a probe import and
#     watching the contract break.
#   - The tool reads source statically and needs none of the packages it names installed,
#     which is why CI runs it from an environment holding only the dev group.

[importlinter]
root_packages =
    backend
include_external_packages = True

[importlinter:contract:layers]
name = The layers depend inwards: api on application, application on domain
type = layers
layers =
    backend.api
    backend.application
    backend.domain
# Higher may import lower, never the reverse, and not through a third module either.
exhaustive = False

[importlinter:contract:domain-is-pure]
name = The domain talks to nothing
type = forbidden
source_modules =
    backend.domain
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    langchain
    langchain_core
    langgraph
    redis
    pymilvus
    httpx
    requests
    openai
    psycopg2
    jinja2
    boto3
    minio
# Pydantic is deliberately NOT here. The sibling domains already use it
# (sis/domain/value_objects.py, sis/domain/grades.py), and a validated value object is a
# domain concept whichever library spells it.

[importlinter:contract:use-cases-speak-no-http]
name = The use cases know nothing of HTTP
type = forbidden
source_modules =
    backend.application
forbidden_modules =
    fastapi
    starlette
# A service that raised HTTPException, or took an UploadFile, could only ever be called from a
# route. Services raise the domain errors in backend/domain/errors.py, and api/errors.py is the
# one place that decides which status each becomes.

[importlinter:contract:use-cases-do-not-reach-for-adapters]
name = The use cases depend on ports, never on what implements them
type = forbidden
source_modules =
    backend.application
forbidden_modules =
    backend.infra
    sqlalchemy
# A service is handed its collaborators by composition.py and names them by the Protocols in
# application/ports/, the way every sis service takes a UnitOfWork and calls Protocols.

[importlinter:contract:use-cases-do-not-run-the-graph]
name = Neither the domain nor the use cases import the graph framework
type = forbidden
source_modules =
    backend.domain
    backend.application
forbidden_modules =
    langgraph
    langchain
    langchain_core
# The turn itself lives in agent/ and stays plain composed code, as the agent frameworks'
# own guidance recommends. Services that need something from it - forgetting the memoized
# corpus languages after an upload, for instance - are handed a callable by composition.py
# instead of importing the retrieval graph to reach it.
