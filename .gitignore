# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env    
.runtime.env

#docker files
volumes/

# OS files
.DS_Store
data/
.worktrees/

# Node / Frontend development
node_modules/
frontend/node_modules/
frontend/dist/

# Knowledge-base source documents. Corpus content is deployment data, often
# contains real personal information, and is loaded through the ingest API — it
# does not belong in the repository.
*.docx
!docs/**/*.docx

# Local dev artifacts generated at the repo root by the identity service when
# IDENTITY_PRIVATE_KEY_PEM / IDENTITY_DATABASE_URL are unset (see identity/keys.py,
# identity/db.py). identity/.gitignore only covers these filenames inside identity/,
# not here.
/identity-dev-key.pem
/identity.db

# SIS local database and scratch verification files
sis.db
.sis_*.db

# Local SQLite databases and pre-test snapshots that .gitignore did not cover.
records.db
*.db.before-*

# Vite dependency-optimisation cache for the SIS console.
sis/frontend/.vite/

# Database backups taken before a migration. Local safety copies, never shared.
sis.db.backup-*

# Tooling caches. Regenerated on every run, machine-specific, never shared.
.pytest_cache/
.ruff_cache/
.mypy_cache/
.notebook/

# Coverage reports from local test runs.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Claude Code local state. settings.json here is an accumulated per-machine
# permission allowlist plus scheduler locks, not shared project configuration.
.claude/

# Per-developer environment overrides. .env.example stays tracked as the template.
.env.local
.env.*.local

# Deployment runbook. Local only: it carries the commands for uploading .env to a
# server, and quotes real credentials inline while doing it. Untracked rather than
# scrubbed so the working copy stays useful to whoever is running the deploy.
UPLOAD_ENV.txt

# Editor and IDE state.
.idea/
.vscode/

# Anchored: this was written for the top-level scratch folder that left the index in
# 5607171. Unanchored it also swallowed deploy/scripts/, which is deployment source and
# has to ship — a directory silently absent from a release is a hard failure to spot.
/scripts/

# pytest run logs; a stray test*.txt at the root is collected as a doctest file
# and a UTF-16 one fails collection before a single test runs.
test_output.txt
# Local demo credentials (never commit)
/اداره.txt
